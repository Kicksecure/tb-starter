#!/bin/bash

## Copyright (C) 2018 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

## Read below with a default rather than bare: each is an OPTIONAL override
## from the caller's environment, so under nounset a bare read would abort the
## browser launch instead of falling back. The '[ -n ... ] ||' defaults stay as
## they are -- they also replace an EXPLICITLY EMPTY value, which
## '[ -v ... ]' does not.
[ -v TOR_DEFAULT_HOMEPAGE ] || TOR_DEFAULT_HOMEPAGE=""
[ -v ICON ] || ICON=""
[ -v tb_install_folder_dot ] || tb_install_folder_dot=""
[ -v tb_title ] || tb_title=""
[ -v tb_wiki ] || tb_wiki=""
[ -v tb_browser_name ] || tb_browser_name=""
[ -v tb_browser_runner ] || tb_browser_runner=""
[ -v tb_settings_folder ] || tb_settings_folder=""
[ -v TOR_NO_DISPLAY_NETWORK_SETTINGS ] || TOR_NO_DISPLAY_NETWORK_SETTINGS=""
[ -v TOR_HIDE_BROWSER_LOGO ] || TOR_HIDE_BROWSER_LOGO=""
[ -v TOR_SKIP_LAUNCH ] || TOR_SKIP_LAUNCH=""
[ -v tb_using_i2p ] || tb_using_i2p=""
[ -v tb_install_folder ] || tb_install_folder=""
[ -v tb_bin ] || tb_bin=""
[ -v tb_i2p_browser ] || tb_i2p_browser=""

## Split from the export: 'export x="$(cmd)"' returns the exit status of
## export, not of the command substitution, so a failing basename would go
## unnoticed under errexit.
SCRIPTNAME="$(basename "${BASH_SOURCE[0]}")"
export SCRIPTNAME

export IDENTIFIER="i2pbrowser"

if [ "${TOR_DEFAULT_HOMEPAGE}" = "/usr/share/doc/homepage/whonix-welcome-page/whonix.html" ]; then
   ## unset default by whonix-welcome-page /usr/libexec/whonix-welcome-page/env_var.sh
   ##
   ## Emptied rather than 'unset': the very next line reads it, and under
   ## nounset an unset read aborts. The default below re-exports it on this
   ## path either way, so what the browser is handed is unchanged.
   TOR_DEFAULT_HOMEPAGE=""
fi

## https://forums.whonix.org/t/noscript-with-security-slider-at-safest-permits-around-30-sites/8160
[ -n "${TOR_DEFAULT_HOMEPAGE}" ] || export TOR_DEFAULT_HOMEPAGE="/usr/share/doc/homepage/i2pbrowser/i2p-diffs.html"

[ -n "${ICON}" ] || export ICON="/usr/share/icons/icon-pack-dist/tbupdate.ico"
[ -n "${TOR_NO_DISPLAY_NETWORK_SETTINGS}" ] || export TOR_NO_DISPLAY_NETWORK_SETTINGS=1
[ -n "${TOR_HIDE_BROWSER_LOGO}" ] || export TOR_HIDE_BROWSER_LOGO=1
[ -n "${TOR_SKIP_LAUNCH}" ] || export TOR_SKIP_LAUNCH=1
[ -n "${tb_using_i2p}" ] || export tb_using_i2p="--i2p"
[ -n "${tb_install_folder}" ] || export tb_install_folder="i2pb"
[ -n "${tb_install_folder_dot}" ] || export tb_install_folder_dot=".i2pb"
[ -n "${tb_title}" ] || export tb_title="i2p Browser"
[ -n "${tb_wiki}" ] || export tb_wiki="i2p_Browser"
[ -n "${tb_browser_name}" ] || export tb_browser_name="i2p-browser"
[ -n "${tb_bin}" ] || export tb_bin="${IDENTIFIER}"
[ -n "${tb_browser_runner}" ] || export tb_browser_runner="start-i2p-browser"
[ -n "${tb_settings_folder}" ] || export tb_settings_folder="i2pbrowser.d"
[ -n "${tb_i2p_browser}" ] || export tb_i2p_browser="true"

# if command -v firejail &>/dev/null ; then
#    [ -n "$tb_hardening" ] || export tb_hardening="true"
# fi

torbrowser "$@"
